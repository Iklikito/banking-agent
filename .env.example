# Which backend to use: gemini (default) or ollama (local, free, no quota)
PROVIDER=ollama

# --- Gemini (PROVIDER=gemini) ---
GEMINI_API_KEY=<your Gemini key from Google AI Studio>
# AGENT_MODEL=gemini-3.6-flash
# JUDGE_MODEL=gemini-3.8-flash
# LLM_RPS=0.1            # requests per second; 0.1 = 6 per minute

# --- Ollama (PROVIDER=ollama) ---
# Run `ollama pull granite4.1:8b` first (check the exact tag on ollama.com).
AGENT_MODEL=granite4.1:8b
JUDGE_MODEL=granite4.1:8b
# OLLAMA_NUM_CTX=4096    # smaller = less VRAM and heat
# OLLAMA_KEEP_ALIVE=2m   # unload the model from VRAM after this much idle time
